@host=localhost:3000
@receiver_host=automation-35.int.cpacket.com:6666

###
# ocsp check
PUT http://{{host}}/api/crypto/v1/tls/check HTTP/1.1
Content-Type: application/json

{
  "domain": "{{receiver_host}}"
}

###
//get cerchain file
GET http://{{host}}/api/crypto/v1/tls/authorities HTTP/1.1

###
//delete cerchain file
DELETE http://{{host}}/api/crypto/v1/tls/authorities HTTP/1.1

###
//upload cerchain file
PUT http://{{host}}/api/crypto/v1/tls/authorities HTTP/1.1
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary{{$timestamp}}

------WebKitFormBoundary{{$timestamp}}
Content-Disposition: form-data; name="bundle"; filename="certchain.cer"
Content-Type: text/plain

< /home/jchen/Downloads/Automation-35.int.cpacket.com/certchain.cer

------WebKitFormBoundary{{$timestamp}}--

###
//upload cerchain file
PUT http://{{host}}/api/crypto/v1/tls/authorities HTTP/1.1
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary{{$timestamp}}

------WebKitFormBoundary{{$timestamp}}
Content-Disposition: form-data; name="bundle"; filename="lin-jchen-01.int.cpacket.com-certchain.cer"
Content-Type: text/plain

< /home/jchen/Downloads/lin-jchen-01.int.cpacket.com/lin-jchen-01.int.cpacket.com-certchain.cer

------WebKitFormBoundary{{$timestamp}}--
